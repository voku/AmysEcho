# Amy's Echo Server Environment Configuration
# Copy this file to .env and update with your production values

# =============================================================================
# SECURITY SETTINGS - CHANGE THESE IN PRODUCTION!
# =============================================================================

# JWT Secret for signing authentication tokens (minimum 32 characters)
# Generate with: openssl rand -hex 32
# Canonical key name is JWT_SECRET (legacy alias JWT_ACCESS_SECRET still works)
JWT_SECRET=your-super-secret-jwt-key-change-in-production

# JWT Refresh Token Secret (minimum 32 characters)
# Generate with: openssl rand -hex 32
# Canonical key name is JWT_REFRESH_SECRET (legacy alias JWT_REFRESH_TOKEN_SECRET still works)
JWT_REFRESH_SECRET=your-super-secret-refresh-key-change-in-production

# Backup encryption secret
# Generate with: openssl rand -hex 32
BACKUP_SECRET=default-secret-password

# =============================================================================
# SERVER CONFIGURATION
# =============================================================================

# Server port (default: 5000)
PORT=5000

# Node environment (development/production)
NODE_ENV=production

# API rate limiting (requests per minute per IP)
API_LIMIT=120

# =============================================================================
# OPTIONAL CONFIGURATION
# =============================================================================

# External ML service URL (if using cloud-based gesture classification)
# CLOUD_API_URL=https://your-ml-service.com/classify

# Gesture task definition URL
# GESTURE_TASK_URL=https://api.github.com/repos/your-org/dgs/contents/tasks

# Custom paths (usually not needed)
# DB_PATH=/custom/path/to/db.json
# MLP_SCRIPT=/custom/path/to/train_mlp.py
