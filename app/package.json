{
  "name": "amys-echo-app",
  "version": "1.0.0",
  "private": true,
  "main": "index.js",
  "scripts": {
    "start": "react-native start",
    "ios": "expo run:ios",
    "android": "expo run:android",
    "lint": "eslint . --ext .js,.jsx,.ts,.tsx",
    "format": "prettier --write \"**/*.{js,jsx,ts,tsx,json,md}\"",
    "test": "jest",
    "type-check": "tsc --noEmit --project tsconfig.json",
    "build:android-dev": "eas build --platform android --profile development --non-interactive",
    "build:android": "eas build --platform android --profile production --non-interactive",
    "build:android-apk": "eas build --platform android --profile apk --non-interactive",
    "build:ios": "eas build --platform ios --profile production --non-interactive",
    "build:webview": "esbuild webview/gestureDetector.ts --bundle --format=iife --outfile=assets/gestureDetector.js --banner:js='// Generated from app/webview/gestureDetector.ts; run npm run build:webview --prefix app'"
  },
  "dependencies": {
    "@nozbe/watermelondb": "0.28.0",
    "@react-native-async-storage/async-storage": "2.1.2",
    "@react-native-community/netinfo": "11.4.1",
    "@react-navigation/native": "6.1.18",
    "@react-navigation/stack": "6.4.1",
    "crypto-js": "4.2.0",
    "expo": "53.0.22",
    "expo-audio": "0.4.9",
    "expo-device": "~7.1.4",
    "expo-file-system": "18.1.11",
    "expo-haptics": "14.1.4",
    "expo-linear-gradient": "14.1.5",
    "expo-secure-store": "14.2.4",
    "expo-speech": "13.1.7",
    "expo-video": "2.2.2",
    "react": "19.0.0",
    "react-native": "0.79.5",
    "react-native-gesture-handler": "2.24.0",
    "react-native-reanimated": "3.17.4",
    "react-native-safe-area-context": "5.4.0",
    "react-native-svg": "15.11.2",
    "react-native-webview": "13.13.5"
  },
  "devDependencies": {
    "@babel/core": "7.28.0",
    "@types/crypto-js": "4.2.1",
    "@types/jest": "29.5.12",
    "@types/react": "19.0.10",
    "babel-jest": "29.7.0",
    "jest": "29.7.0",
    "jest-expo": "^53.0.10",
    "ts-jest": "29.4.1",
    "typescript": "5.8.3",
    "esbuild": "^0.21.5",
    "fflate": "^0.8.2"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx}": [
      "eslint --fix",
      "prettier --write"
    ]
  },
  "expo": {
    "doctor": {
      "reactNativeDirectoryCheck": {
        "exclude": [
          "@nozbe/watermelondb"
        ],
        "listUnknownPackages": false
      }
    }
  }
}
