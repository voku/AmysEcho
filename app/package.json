{
  "name": "amys-echo-app",
  "version": "1.0.0",
  "private": true,
  "main": "index.js",
  "scripts": {
    "start": "react-native start",
    "ios": "expo run:ios",
    "android": "expo run:android",
    "web": "expo start --web",
    "lint": "eslint . --ext .js,.jsx,.ts,.tsx",
    "format": "prettier --write \"**/*.{js,jsx,ts,tsx,json,md}\"",
    "test": "jest",
    "type-check": "tsc --noEmit --project tsconfig.json",
    "build:android-dev": "eas build --platform android --profile development --non-interactive",
    "build:android": "eas build --platform android --profile production --non-interactive",
    "build:android-apk": "eas build --platform android --profile apk --non-interactive",
    "build:ios": "eas build --platform ios --profile production --non-interactive"
  },
  "dependencies": {
    "@babel/runtime": "7.28.2",
    "@nozbe/watermelondb": "0.28.0",
    "@nozbe/with-observables": "1.6.0",
    "@react-native-async-storage/async-storage": "2.1.2",
    "@react-native-community/netinfo": "11.4.1",
    "@react-navigation/native": "6.1.18",
    "@react-navigation/native-stack": "6.11.0",
    "@react-navigation/stack": "6.4.1",
    "@shopify/react-native-skia": "^2.0.0-next.4",
    "better-sqlite3": "12.2.0",
    "crypto-js": "4.2.0",
    "expo": "53.0.20",
    "expo-audio": "0.4.8",
    "expo-camera": "16.1.11",
    "expo-doctor": "1.13.5",
    "expo-haptics": "14.1.4",
    "expo-linear-gradient": "14.1.5",
    "expo-secure-store": "14.2.3",
    "expo-speech": "13.1.7",
    "expo-video": "2.2.2",
    "lucide-react-native": "0.535.0",
    "react": "19.0.0",
    "react-native": "0.79.5",
    "react-native-fast-tflite": "1.6.1",
    "react-native-gesture-handler": "2.24.0",
    "react-native-permissions": "5.4.1",
    "react-native-reanimated": "3.17.4",
    "react-native-safe-area-context": "5.4.0",
    "react-native-screens": "4.11.1",
    "react-native-svg": "^15.11.2",
    "react-native-vision-camera": "4.7.1",
    "react-native-worklets-core": "1.6.0",
    "vision-camera-resize-plugin": "3.2.0",
    "expo-battery": "~9.1.4",
    "expo-device": "~7.1.4"
  },
  "devDependencies": {
    "@babel/core": "7.28.0",
    "@babel/plugin-transform-runtime": "7.28.0",
    "@babel/preset-env": "7.28.0",
    "@babel/preset-flow": "7.27.1",
    "@babel/preset-typescript": "7.27.1",
    "@react-native-community/cli": "latest",
    "@types/crypto-js": "4.2.1",
    "@types/jest": "30.0.0",
    "@types/react": "19.0.10",
    "babel-jest": "30.0.5",
    "expo-dev-client": "5.2.4",
    "identity-obj-proxy": "3.0.0",
    "jest": "29.7.0",
    "jest-expo": "53.0.9",
    "jest-transform-stub": "2.0.0",
    "metro": "0.82.3",
    "metro-config": "0.82.3",
    "metro-runtime": "0.82.3",
    "metro-source-map": "0.82.3",
    "ts-jest": "29.4.0",
    "ts-node": "10.9.2",
    "typescript": "5.8.3"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx}": [
      "eslint --fix",
      "prettier --write"
    ]
  },
  "expo": {
    "doctor": {
      "reactNativeDirectoryCheck": {
        "exclude": [
          "@nozbe/watermelondb",
          "@nozbe/with-observables",
          "better-sqlite3"
        ],
        "listUnknownPackages": false
      }
    }
  }
}
