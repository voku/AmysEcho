{
  "name": "amys-echo-app",
  "version": "1.0.0",
  "private": true,
  "main": "index.js",
  "scripts": {
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "start": "expo start",
    "test": "jest --detectOpenHandles --coverage --watchAll=false --verbose",
    "test:watch": "jest --detectOpenHandles --coverage",
    "test:memory": "node --max-old-space-size=4096 node_modules/.bin/jest --detectOpenHandles --coverage --watchAll=false --verbose",
    "type-check": "npx tsc --noEmit --project tsconfig.json",
    "lint": "eslint . --ext .js,.jsx,.ts,.tsx",
    "lint:fix": "eslint . --ext .js,.jsx,.ts,.tsx --fix",
    "build:webview": "npx tsc --project webview/tsconfig.json",
    "clean": "rm -rf node_modules/.cache && rm -rf .expo && rm -rf dist"
  },
  "dependencies": {
    "@nozbe/watermelondb": "0.28.0",
    "@react-native-async-storage/async-storage": "2.1.2",
    "@react-native-community/netinfo": "11.4.1",
    "@react-navigation/native": "6.1.18",
    "@react-navigation/stack": "6.4.1",
    "crypto-js": "4.2.0",
    "expo": "53.0.22",
    "expo-audio": "0.4.9",
    "expo-file-system": "18.1.11",
    "expo-haptics": "14.1.4",
    "expo-linear-gradient": "14.1.5",
    "expo-secure-store": "14.2.4",
    "expo-speech": "13.1.7",
    "expo-video": "2.2.2",
    "react": "19.0.0",
    "react-native": "0.79.5",
    "react-native-gesture-handler": "2.24.0",
    "react-native-reanimated": "3.17.4",
    "react-native-safe-area-context": "5.4.0",
    "react-native-screens": "~4.11.1",
    "react-native-svg": "15.11.2",
    "react-native-webview": "13.13.5",
    "zustand": "^5.0.8"
  },
  "devDependencies": {
    "@babel/core": "7.28.3",
    "@jest/globals": "^29.7.0",
    "@testing-library/react-native": "^13.3.3",
    "@types/crypto-js": "4.2.1",
    "@types/jest": "29.5.14",
    "@types/node": "^20.0.0",
    "@types/react": "19.0.10",
    "esbuild": "^0.25.0",
    "eslint": "^9.34.0",
    "eslint-plugin-jest": "^29.0.1",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^5.2.0",
    "fflate": "^0.8.2",
    "globals": "^16.3.0",
    "jest": "29.7.0",
    "jest-expo": "^53.0.10",
    "lint-staged": "^15.0.0",
    "react-test-renderer": "19.0.0",
    "typescript": "~5.8.3",
    "typescript-eslint": "^8.42.0"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx}": [
      "eslint --fix",
      "prettier --write"
    ]
  },
  "expo": {
    "doctor": {
      "reactNativeDirectoryCheck": {
        "exclude": [
          "@nozbe/watermelondb"
        ],
        "listUnknownPackages": false
      }
    }
  }
}
