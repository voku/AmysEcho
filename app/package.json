{
  "name": "amys-echo-app",
  "version": "1.0.0",
  "private": true,
  "main": "index.js",
  "scripts": {
    "start": "react-native start",
    "ios": "expo run:ios",
    "android": "expo run:android",
    "web": "expo start --web",
    "lint": "eslint . --ext .js,.jsx,.ts,.tsx",
    "format": "prettier --write \"**/*.{js,jsx,ts,tsx,json,md}\"",
    "test": "npx ts-node test/run-tests.ts",
    "type-check": "tsc --noEmit --project tsconfig.json",
    "build:android": "eas build --platform android --profile production --non-interactive",
    "build:ios": "eas build --platform ios --profile production --non-interactive"
  },
  "dependencies": {
    "@nozbe/watermelondb": "^0.28.0",
    "@nozbe/with-observables": "^1.6.0",
    "better-sqlite3": "^12.2.0",
    "@react-native-async-storage/async-storage": "2.1.2",
    "@react-native-community/netinfo": "11.4.1",
    "@react-navigation/native": "^6.1.18",
    "@react-navigation/native-stack": "^6.11.0",
    "@react-navigation/stack": "^6.4.1",
    "expo": "^53.0.20",
    "expo-audio": "^0.4.8",
    "expo-haptics": "^14.1.4",
    "expo-secure-store": "^14.2.3",
    "expo-speech": "^13.1.7",
    "expo-video": "^2.2.2",
    "react": "19.0.0",
    "react-native": "0.79.5",
    "react-native-fast-tflite": "^1.6.1",
    "react-native-gesture-handler": "^2.27.1",
    "react-native-permissions": "^5.4.1",
    "react-native-reanimated": "~3.17.4",
    "react-native-safe-area-context": "^5.5.2",
    "react-native-screens": "^4.13.0",
    "react-native-vision-camera": "^4.0.0"
  },
  "devDependencies": {
    "@babel/core": "^7.28.0",
    "@babel/plugin-transform-runtime": "^7.28.0",
    "@babel/preset-env": "^7.28.0",
    "@babel/preset-typescript": "^7.27.1",
    "@react-native-community/cli": "latest",
    "@types/jest": "^30.0.0",
    "@types/react": "~19.0.10",
    "babel-jest": "^30.0.5",
    "expo-dev-client": "^5.2.4",
    "identity-obj-proxy": "^3.0.0",
    "jest": "~29.7.0",
    "jest-expo": "^53.0.9",
    "jest-transform-stub": "^2.0.0",
    "metro": "^0.82.3",
    "metro-config": "^0.82.3",
    "metro-runtime": "^0.82.3",
    "metro-source-map": "^0.82.3",
    "ts-jest": "^29.4.0",
    "typescript": "~5.8.3"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx}": [
      "eslint --fix",
      "prettier --write"
    ]
  }
