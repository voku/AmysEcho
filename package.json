{
  "name": "amys-echo",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "typecheck": "tsc --noEmit --project tsconfig.json",
    "build": "tsc --project tsconfig.json && node scripts/assemble.mjs",
    "test": "node scripts/run-tests.mjs",
    "smoke:offline": "node scripts/offline-smoke.mjs",
    "verify": "npm run typecheck && npm run build && npm test && npm run smoke:offline && npm run test:browser",
    "test:browser": "node scripts/run-tests.mjs test/browser"
  },
  "devDependencies": {
    "@mediapipe/tasks-vision": "0.10.35",
    "playwright": "1.63.0",
    "typescript": "7.0.2"
  }
}
