{
  "name": "amys-echo",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "typecheck": "tsc --noEmit --project tsconfig.json",
    "build": "tsc --project tsconfig.json && node scripts/assemble.mjs",
    "test": "node scripts/run-tests.mjs",
    "smoke:offline": "node scripts/offline-smoke.mjs",
    "verify": "npm run typecheck && npm run build && npm test && npm run smoke:offline"
  },
  "devDependencies": {
    "typescript": "6.0.3"
  }
}
