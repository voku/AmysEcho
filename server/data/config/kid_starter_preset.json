  "trainingConfig": {
    "minSamplesPerGloss": 5,
    "targetSamplesPerGloss": 15,
    "classWeights": {
      "high": 1.0,
      "medium": 1.2,
      "low": 1.5
    },
    "dataSplits": {
      "train": 0.7,
      "validation": 0.15,
      "test": 0.15
    },
    "augmentationSettings": {
      "temporalJitter": true,
      "spatialNoise": true,
      "mirrorHands": false
    }
  },
  "qualityGates": {
    "minHandsCoverage": 0.7,
    "minPoseCoverage": 0.4,
    "minFaceCoverage": 0.4,
    "minUsableFrameRatio": 0.6,
    "minClipDurationMs": 500,
    "maxJitterThreshold": 0.15,
    "reviewRequiredForGlobal": true
  },
  "metadata": {
    "createdAt": "2026-02-03",
    "lastUpdated": "2026-02-03",
    "maintainer": "Amy's Echo Team",
    "notes": "Starter-Vokabular für die Deutsche Gebärdensprache (DGS) Erkennung bei Kindern. Basiert auf häufig genutzten Kommunikationsbedürfnissen nicht-sprechender Kinder."
