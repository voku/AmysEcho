{
  "name": "amysecho_backend",
  "version": "1.0.0",
  "description": "Backend: Gesture to voice translator for Amy",
  "main": "index.js",
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "module",
  "dependencies": {
    "@babel/runtime": "7.29.2",
    "@types/bcrypt": "6.0.0",
    "@types/jsonwebtoken": "9.0.10",
    "adm-zip": "^0.5.17",
    "bcrypt": "6.0.0",
    "better-sqlite3": "^12.9.0",
    "express": "5.2.1",
    "express-rate-limit": "8.4.1",
    "jsonwebtoken": "9.0.3",
    "nodemailer": "^9.0.0",
    "zod": "^4.2.1"
  },
  "devDependencies": {
    "@babel/preset-env": "^7.29.2",
    "@babel/preset-typescript": "^7.28.5",
    "@eslint/js": "^10.0.0",
    "@types/adm-zip": "^0.5.7",
    "@types/better-sqlite3": "^7.6.13",
    "@types/express": "^5.0.6",
    "@types/jest": "^30.0.0",
    "@types/node": "24.12.0",
    "@types/nodemailer": "^8.0.0",
    "@types/supertest": "^7.0.0",
    "@typescript-eslint/eslint-plugin": "^8.59.1",
    "@typescript-eslint/parser": "^8.59.1",
    "babel-jest": "^30.3.0",
    "eslint": "^10.2.1",
    "jest": "^30.3.0",
    "supertest": "^7.0.0",
    "ts-node": "10.9.2",
    "typescript": "6.0.3"
  },
  "scripts": {
    "test": "sh -c 'npm run test:ts -- \"$@\" && npm run test:py' sh \"$@\"",
    "test:ts": "jest --maxWorkers=50% --detectOpenHandles",
    "test:ts:serial": "jest --runInBand --detectOpenHandles",
    "pretest:py": "npm run build",
    "test:py": "sh -c 'PY_BIN=$(node ./scripts/resolve-python-bin.mjs) && PYTHONPATH=./src:./ \"$PY_BIN\" -m pytest -q'",
    "train:mlp": "sh -c 'PY_BIN=$(node ./scripts/resolve-python-bin.mjs) && \"$PY_BIN\" src/amyserver_tools/train_mlp.py'",
    "dataset:readiness": "sh -c 'PY_BIN=$(node ./scripts/resolve-python-bin.mjs) && \"$PY_BIN\" src/amyserver_tools/evaluate_dataset_readiness.py --manifest data/datasets/training_manifest.json --data-dir data --output-dir data/dataset-readiness'",
    "train:mlp:sweep": "sh -c 'PY_BIN=$(node ./scripts/resolve-python-bin.mjs) && \"$PY_BIN\" src/amyserver_tools/train_mlp_sweep.py'",
    "train:workflow:smoke": "sh -c 'PY_BIN=$(node ./scripts/resolve-python-bin.mjs) && \"$PY_BIN\" ../scripts/training_workflow_smoke.py'",
    "ops:post-training-cadence": "node dist/tools/runPostTrainingCadence.js",
    "type-check": "tsc --noEmit --project tsconfig.json",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "build": "sh -c 'rm -rf dist && tsc'",
    "start": "node dist/server.js",
    "download-gesture-task": "ts-node src/tools/getGestureTask.ts",
    "generate-token": "node scripts/generate-token.js",
    "stress-test": "node scripts/stress-test.js",
    "train:mlp:realistic": "sh -c 'PY_BIN=$(node ./scripts/resolve-python-bin.mjs) && \"$PY_BIN\" ../scripts/realistic_dgs_training_cycle.py --workflow-preset chat-validated-2026-03 --auto-promote-on-usable'"
  },
  "engines": {
    "node": ">=18.13.0"
  }
}
