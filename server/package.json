{
  "name": "amysecho_backend",
  "version": "1.0.0",
  "description": "Backend: Gesture to voice translator for Amy",
  "main": "index.js",
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "module",
  "dependencies": {
    "@babel/runtime": "7.28.6",
    "@types/bcrypt": "6.0.0",
    "@types/jsonwebtoken": "9.0.10",
    "adm-zip": "^0.5.16",
    "bcrypt": "6.0.0",
    "better-sqlite3": "^12.6.2",
    "express": "5.2.1",
    "express-rate-limit": "8.3.0",
    "jsonwebtoken": "9.0.3",
    "nodemailer": "^8.0.0",
    "zod": "^4.2.1"
  },
  "devDependencies": {
    "@babel/preset-env": "^7.25.4",
    "@babel/preset-typescript": "^7.24.7",
    "@types/adm-zip": "^0.5.7",
    "@types/better-sqlite3": "^7.6.13",
    "@types/express": "^5.0.6",
    "@types/jest": "^30.0.0",
    "@types/node": "24.10.15",
    "@types/nodemailer": "^7.0.0",
    "@types/supertest": "^6.0.2",
    "@typescript-eslint/eslint-plugin": "^8.56.0",
    "@typescript-eslint/parser": "^8.56.0",
    "babel-jest": "^30.0.0",
    "eslint": "^9.39.3",
    "jest": "^30.0.0",
    "supertest": "^7.0.0",
    "ts-node": "10.9.2",
    "typescript": "5.9.3"
  },
  "scripts": {
    "test": "sh -c 'npm run test:ts -- \"$@\" && npm run test:py' sh \"$@\"",
    "test:ts": "jest --runInBand --detectOpenHandles",
    "pretest:py": "npm run build",
    "test:py": "PYTHONPATH=./src:./ pytest -q",
    "train:mlp": "python3 src/amyserver_tools/train_mlp.py",
    "type-check": "tsc --noEmit --project tsconfig.json",
    "lint": "eslint . --ext .ts,.js",
    "lint:fix": "eslint . --ext .ts,.js --fix",
    "build": "sh -c 'rm -rf dist && tsc'",
    "start": "node dist/server.js",
    "download-gesture-task": "ts-node src/tools/getGestureTask.ts",
    "generate-token": "node scripts/generate-token.js",
    "stress-test": "node scripts/stress-test.js",
    "train:mlp:realistic": "python3 ../scripts/realistic_dgs_training_cycle.py --workflow-preset chat-validated-2026-03 --auto-promote-on-usable"
  },
  "engines": {
    "node": ">=18.13.0"
  },
  "overrides": {
    "minimatch": "^10.2.2"
  }
}
