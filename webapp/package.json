{
  "name": "webapp",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "engines": {
    "node": ">=18.13.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -p tsconfig.app.json --noEmit && vite build",
    "lint": "eslint . --report-unused-disable-directives --max-warnings 0",
    "test": "vitest run",
    "type-check": "tsc -p tsconfig.app.json --noEmit",
    "preview": "vite preview",
    "benchmark:temporal-smoothing": "vite-node scripts/benchmark-temporal-smoothing.ts",
    "deps-snapshot": "npm ls --all --json --silent --legacy-peer-deps > ../docs/deps/webapp-deps.json",
    "test:coverage": "vitest run --coverage",
    "diagnose:fixtures": "vite-node scripts/gesture-fixture-diagnose.ts"
  },
  "dependencies": {
    "fflate": "^0.8.2",
    "js-sha256": "^0.11.0",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "react-router-dom": "^7.11.0"
  },
  "devDependencies": {
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/jsdom": "^28.0.0",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "@typescript-eslint/eslint-plugin": "^8.57.2",
    "@typescript-eslint/parser": "^8.57.2",
    "@vitejs/plugin-react": "^5.1.2",
    "@vitest/coverage-v8": "^4.0.18",
    "eslint": "^9.39.4",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.5.0",
    "fake-indexeddb": "^6.2.5",
    "globals": "^17.4.0",
    "happy-dom": "^20.8.8",
    "jsdom": "^28.0.0",
    "typescript": "^5.2.2",
    "vite": "7.3.2",
    "vitest": "^4.0.13",
    "vite-node": "^5.3.0"
  },
  "overrides": {
    "minimatch": "^10.2.2"
  }
}
